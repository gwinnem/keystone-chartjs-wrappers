{
  "name": "keystone-chartjs-angular",
  "version": "1.0.0",
  "private": false,
  "description": "A single, generic KeystoneChartComponent for Angular wrapping Chart.js — every built-in chart type plus the financial, boxplot, matrix, sankey, and treemap extensions, selected via a `type` input.",
  "keywords": [
    "angular",
    "angular-component",
    "standalone-component",
    "chartjs",
    "chart.js",
    "chart",
    "charts",
    "data-visualization",
    "visualization",
    "typescript",
    "bar-chart",
    "line-chart",
    "horizontal-bar",
    "pie-chart",
    "doughnut-chart",
    "radar-chart",
    "polar-area",
    "scatter-chart",
    "bubble-chart",
    "mixed-chart",
    "candlestick",
    "ohlc",
    "boxplot",
    "violin",
    "treemap",
    "sankey",
    "matrix-chart",
    "zoom",
    "annotation",
    "datalabels",
    "resize"
  ],
  "author": "Geirr Winnem",
  "license": "MIT",
  "homepage": "https://kcw.winnem.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-chartjs-wrappers.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-chartjs-wrappers/issues"
  },
  "type": "commonjs",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "peerDependencies": {
    "@angular/core": "^19.0.0",
    "@angular/common": "^19.0.0",
    "chart.js": "^4.5.1"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "angular-eslint": "^19.0.0",
    "@angular/animations": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular-devkit/build-angular": "^19.0.0",
    "@playwright/test": "^1.45.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@types/jest": "^29.5.0",
    "chart.js": "^4.5.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.1.0",
    "keystone-chartjs-core": "workspace:*",
    "ng-packagr": "^19.0.0",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "zone.js": "^0.15.0"
  }
}
