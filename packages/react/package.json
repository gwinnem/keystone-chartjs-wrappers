{
  "name": "keystone-chartjs-react",
  "version": "1.0.0",
  "homepage": "https://kcw.winnem.tech",
  "private": false,
  "description": "A single, generic <Chart> component for React wrapping Chart.js — every built-in chart type plus the financial, boxplot, matrix, sankey, and treemap extensions, selected via a `type` prop.",
  "keywords": [
    "react",
    "react-hooks",
    "chartjs",
    "chart.js",
    "chart",
    "charts",
    "data-visualization",
    "visualization",
    "typescript",
    "bar-chart",
    "line-chart",
    "horizontal-bar",
    "pie-chart",
    "doughnut-chart",
    "radar-chart",
    "polar-area",
    "scatter-chart",
    "bubble-chart",
    "mixed-chart",
    "candlestick",
    "ohlc",
    "boxplot",
    "violin",
    "treemap",
    "sankey",
    "matrix-chart",
    "zoom",
    "annotation",
    "datalabels",
    "resize",
    "reactive"
  ],
  "author": "Geirr Winnem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-chartjs-wrappers.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-chartjs-wrappers/issues"
  },
  "type": "module",
  "main": "./dist/keystone-chartjs-react.umd.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/es/index.js",
      "require": "./dist/keystone-chartjs-react.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:component": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "chart.js": "^4.5.1",
    "jsdom": "^24.1.0",
    "keystone-chartjs-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.0.0"
  }
}
