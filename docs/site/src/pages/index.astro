---
// Landing page — promoted from docs/_design/mockup-landing.html once
// approved. Deliberately a plain Astro page, not part of the Starlight
// `docs` collection, same as keystone-dashboard-layout's own
// src/pages/index.astro. The top navbar itself now lives in
// SiteNav.astro, shared with every Starlight doc page (see that
// component's own header comment, and the `Header` override in
// astro.config.mjs).
import SiteNav from '../components/SiteNav.astro';
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keystone Chart.js Wrappers — one wrapper component, every Chart.js chart, for Vue, React &amp; Angular</title>
  <meta name="description" content="A single generic <Chart> component wrapping Chart.js for Vue, React & Angular — every built-in chart type plus financial, boxplot, matrix, sankey & treemap extensions, one framework-agnostic core underneath.">
  <link rel="canonical" href="https://kcw.winnem.tech/">
  <script is:inline>
    // Runs before paint so the correct theme is already applied before
    // anything is visible. Reads the same 'starlight-theme' key
    // (empty string = auto, 'light'/'dark' otherwise) that SiteNav.astro's
    // theme toggle writes to and that every Starlight doc page's own
    // built-in early-theme script also reads — one shared key, kept in
    // sync across this plain page and every Starlight page.
    (function () {
      var stored = localStorage.getItem('starlight-theme');
      var theme = stored === 'light' || stored === 'dark' ? stored : 'auto';
      var resolved = theme === 'auto'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : theme;
      document.documentElement.setAttribute('data-theme', resolved);
      document.documentElement.setAttribute('data-theme-pref', theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    @import '../styles/tokens.css';
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}

    /* Page-local semantic tokens, layered on top of the shared --kg-*
       tokens imported above — only the content sections below the hero
       switch between light/dark; nav/hero/footer stay dark in both
       modes, same split as keystone-dashboard-layout's index.astro. */
    :root{
      --page-bg:var(--kg-paper);
      --page-text:var(--kg-text-hi-light);
      --page-text-lo:var(--kg-text-lo-light);
      --page-line:var(--kg-line-light);
      --card-bg:#ffffff;
      --card-bg-live:#FFFCF5;
      --link-live-color:var(--kg-amber-deep);
      --spec-bg:var(--kg-paper-3);
    }
    [data-theme="dark"]{
      --page-bg:var(--kg-ink);
      --page-text:var(--kg-text-hi-dark);
      --page-text-lo:var(--kg-text-lo-dark);
      --page-line:var(--kg-line-dark);
      --card-bg:var(--kg-ink-2);
      --card-bg-live:var(--kg-ink-3);
      --link-live-color:var(--kg-amber);
      --spec-bg:var(--kg-ink-3);
    }

    body{font-family:var(--kg-font-body);background:var(--page-bg);color:var(--page-text);-webkit-font-smoothing:antialiased;}
    a{color:inherit;text-decoration:none;}
    .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}

    .hero{background:var(--kg-ink);background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.09) 1px, transparent 0);background-size:26px 26px;padding:88px 0 0;position:relative;overflow:hidden;}
    .hero-inner{max-width:1180px;margin:0 auto;padding:0 32px 96px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:56px;align-items:center;}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:var(--kg-font-mono);font-size:12px;letter-spacing:0.06em;color:var(--kg-blueprint);border:1px solid var(--kg-blueprint-deep);background:rgba(79,184,201,0.08);padding:6px 12px;border-radius:100px;margin-bottom:24px;}
    .eyebrow-dot{width:6px;height:6px;border-radius:50%;background:var(--kg-amber);}
    h1.headline{font-family:var(--kg-font-display);font-weight:600;font-size:54px;line-height:1.06;letter-spacing:-0.02em;color:var(--kg-text-hi-dark);margin-bottom:22px;}
    h1.headline .accent{color:var(--kg-amber);}
    .hero-sub{font-size:17px;line-height:1.65;color:var(--kg-text-lo-dark);max-width:490px;margin-bottom:36px;}
    .hero-sub code{font-family:var(--kg-font-mono);font-size:15px;color:var(--kg-blueprint);background:rgba(79,184,201,0.1);padding:1px 6px;border-radius:4px;}
    .fw-inline{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}
    .fw-inline svg{width:14px;height:14px;flex-shrink:0;}
    .cta-row{display:flex;align-items:center;gap:14px;margin-bottom:44px;}
    .btn{font-family:var(--kg-font-body);font-weight:500;font-size:14px;padding:12px 22px;border-radius:7px;display:inline-flex;align-items:center;gap:8px;}
    .btn-primary{background:var(--kg-amber);color:#2B1B02;}
    .btn-ghost{border:1px solid var(--kg-line-dark);color:var(--kg-text-hi-dark);}
    .hero-meta{display:flex;gap:28px;font-family:var(--kg-font-mono);font-size:12.5px;color:var(--kg-text-lo-dark);}
    .hero-meta strong{color:var(--kg-text-hi-dark);font-weight:500;}

    .stage{position:relative;height:460px;border-radius:14px;background:var(--kg-ink-2);border:1px solid var(--kg-line-dark);overflow:hidden;padding:20px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:16px;}
    .tile{background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);border-radius:10px;padding:14px 16px;display:flex;flex-direction:column;}
    .tile .label{font-family:var(--kg-font-mono);font-size:11px;color:var(--kg-text-lo-dark);margin-bottom:8px;}
    .tile-chart{flex:1;width:100%;}
    .code-badge{position:absolute;top:20px;right:20px;font-family:var(--kg-font-mono);font-size:11px;color:var(--kg-amber);background:var(--kg-ink);border:1px solid var(--kg-amber-deep);padding:5px 9px;border-radius:6px;white-space:nowrap;z-index:6;}

    .section{padding:80px 0;}
    .section-head{margin-bottom:40px;max-width:640px;}
    .section-eyebrow{font-family:var(--kg-font-mono);font-size:12px;letter-spacing:0.08em;color:var(--kg-blueprint-deep);margin-bottom:12px;display:block;}
    h2.section-title{font-family:var(--kg-font-display);font-weight:600;font-size:30px;letter-spacing:-0.015em;margin-bottom:12px;color:var(--page-text);}
    .section-desc{font-size:15.5px;line-height:1.6;color:var(--page-text-lo);}

    .picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
    .picker-card{border:1px solid var(--page-line);border-radius:12px;padding:26px 24px;background:var(--card-bg);display:flex;flex-direction:column;gap:14px;}
    .picker-card.is-planned{border-style:dashed;opacity:0.85;}
    .picker-icon{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;}
    .picker-icon svg{width:20px;height:20px;}
    .icon-vue{background:rgba(79,184,201,0.14);}
    .icon-react{background:rgba(97,218,251,0.14);}
    .icon-angular{background:rgba(221,0,49,0.09);}
    .icon-core{background:rgba(242,169,59,0.14);}
    .picker-card-core{grid-column:1 / -1;flex-direction:row;align-items:center;gap:22px;padding:22px 26px;}
    .picker-card-core .picker-body{flex:1;min-width:0;}
    .picker-title{font-family:var(--kg-font-display);font-weight:600;font-size:18px;}
    .picker-desc{font-size:14px;line-height:1.55;color:var(--page-text-lo);}
    .picker-status{font-family:var(--kg-font-mono);font-size:11px;color:var(--page-text-lo);}
    .picker-links{margin-top:auto;}
    .picker-link{font-family:var(--kg-font-mono);font-size:12.5px;color:var(--page-text-lo);}

    .spec{background:var(--spec-bg);border-top:1px solid var(--page-line);border-bottom:1px solid var(--page-line);}
    .spec-grid{display:grid;grid-template-columns:repeat(4,1fr);}
    .spec-cell{padding:26px 24px;border-right:1px solid var(--page-line);border-bottom:1px solid var(--page-line);}
    .spec-cell:nth-child(4n){border-right:none;}
    .spec-icon{font-family:var(--kg-font-mono);font-size:12px;color:var(--kg-blueprint-deep);margin-bottom:12px;display:block;}
    .spec-title{font-family:var(--kg-font-display);font-weight:600;font-size:14.5px;margin-bottom:6px;}
    .spec-desc{font-size:13.5px;line-height:1.5;color:var(--page-text-lo);}

    .kind-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
    .kind-cell{border:1px solid var(--page-line);border-radius:10px;padding:16px 18px;background:var(--card-bg);}
    .kind-cell .kind-name{font-family:var(--kg-font-display);font-weight:600;font-size:14px;margin-bottom:4px;}
    .kind-cell .kind-source{font-family:var(--kg-font-mono);font-size:10.5px;color:var(--page-text-lo);}
    .kind-cell.is-core{border-color:var(--kg-blueprint-deep);}
    .kind-cell.is-extension{border-style:dashed;}

    .footer{background:var(--kg-ink);padding:44px 0;}
    .footer-inner{display:flex;align-items:center;justify-content:center;}
    .footer-brand{display:flex;align-items:center;gap:10px;}

    @media(max-width:920px){
      .hero-inner{grid-template-columns:1fr;}
      .picker-grid{grid-template-columns:1fr;}
      .spec-grid{grid-template-columns:repeat(2,1fr);}
      .kind-grid{grid-template-columns:repeat(2,1fr);}
      h1.headline{font-size:38px;}
    }
  </style>
</head>
<body>

  <SiteNav />

  <header class="hero">
    <div class="hero-inner">
      <div>
        <span class="eyebrow"><span class="eyebrow-dot"></span>ONE COMPONENT · EVERY CHART TYPE</span>
        <h1 class="headline">One <span class="accent">&lt;Chart&gt;</span>.<br>Every Chart.js type.</h1>
        <p class="hero-sub">A single, generic component wraps Chart.js's full chart catalogue — set <code>type="candlestick"</code> or <code>type="sankey"</code> and it just renders. One framework-agnostic core, idiomatic components for <span class="fw-inline"><svg viewBox="0 0 24 24" fill="#42B883"><path d="M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z"/></svg>Vue</span>, <span class="fw-inline"><svg viewBox="0 0 24 24" fill="#61DAFB"><path d="M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.345-.034-.46 0-.915.01-1.36.034.44-.572.895-1.096 1.345-1.565zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.098 2.21-.098zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.386zm7.26 0c.695.103 1.365.23 2.006.387-.18.632-.405 1.282-.66 1.933-.2-.39-.41-.783-.64-1.174-.225-.392-.465-.774-.705-1.146zm3.063.675c.484.15.944.317 1.375.498 1.732.74 2.852 1.708 2.852 2.476-.005.768-1.125 1.74-2.857 2.475-.42.18-.88.342-1.355.493-.28-.958-.646-1.956-1.1-2.98.45-1.017.81-2.01 1.085-2.964zm-13.395.004c.278.96.645 1.957 1.1 2.98-.45 1.017-.812 2.01-1.086 2.964-.484-.15-.944-.318-1.37-.5-1.732-.737-2.852-1.706-2.852-2.474 0-.768 1.12-1.742 2.852-2.476.42-.18.88-.342 1.356-.494zm11.678 4.28c.265.657.49 1.312.676 1.948-.64.157-1.316.29-2.016.39.24-.375.48-.762.705-1.158.225-.39.435-.788.636-1.18zm-9.945.02c.2.392.41.783.64 1.175.23.39.465.772.705 1.143-.695-.102-1.365-.23-2.006-.386.18-.63.406-1.282.66-1.933zM17.92 16.32c.112.493.2.968.254 1.423.23 1.868-.054 3.32-.714 3.708-.147.09-.338.128-.563.128-1.012 0-2.514-.807-4.11-2.28.686-.72 1.37-1.536 2.02-2.44 1.107-.118 2.154-.3 3.113-.54zm-11.83.01c.96.234 2.006.415 3.107.532.66.905 1.345 1.727 2.035 2.446-1.595 1.483-3.092 2.295-4.11 2.295-.22-.005-.406-.05-.553-.132-.666-.38-.955-1.834-.73-3.703.054-.46.142-.944.25-1.438zm4.56.64c.44.02.89.034 1.345.034.46 0 .915-.01 1.36-.034-.44.572-.895 1.095-1.345 1.565-.455-.47-.91-.993-1.36-1.565z"/></svg>React</span>, and <span class="fw-inline"><svg viewBox="0 0 24 24" fill="#DD0031"><path d="M16.712 17.711H7.288l-1.204 2.916L12 24l5.916-3.373-1.204-2.916ZM14.692 0l7.832 16.855.814-12.856L14.692 0ZM9.308 0 .662 3.999l.814 12.856L9.308 0Zm-.405 13.93h6.198L12 6.396 8.903 13.93Z"/></svg>Angular</span>.</p>
        <div class="cta-row">
          <a class="btn btn-ghost" href="https://github.com/gwinnem/keystone-chartjs-wrappers">View on GitHub</a>
        </div>
        <div class="hero-meta">
          <span><strong>8</strong> built-in chart types</span>
          <span><strong>5</strong> ecosystem extensions</span>
          <span><strong>10</strong> official plugins</span>
        </div>
      </div>

      <div class="stage">
        <span class="code-badge">&lt;Chart type="..." /&gt;</span>
        <div class="tile">
          <span class="label">type="bar"</span>
          <svg class="tile-chart" viewBox="0 0 100 50" preserveAspectRatio="none">
            <rect x="6" y="24" width="12" height="20" rx="2" fill="var(--kg-blueprint)"/>
            <rect x="24" y="12" width="12" height="32" rx="2" fill="var(--kg-blueprint)"/>
            <rect x="42" y="30" width="12" height="14" rx="2" fill="var(--kg-amber)"/>
            <rect x="60" y="6" width="12" height="38" rx="2" fill="var(--kg-blueprint)"/>
            <rect x="78" y="18" width="12" height="26" rx="2" fill="var(--kg-blueprint)"/>
          </svg>
        </div>
        <div class="tile">
          <span class="label">type="line"</span>
          <svg class="tile-chart" viewBox="0 0 100 50" preserveAspectRatio="none">
            <polyline points="4,40 22,28 40,34 58,14 76,22 96,4" fill="none" stroke="var(--kg-blueprint)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="96" cy="4" r="3" fill="var(--kg-amber)"/>
          </svg>
        </div>
        <div class="tile">
          <span class="label">type="doughnut"</span>
          <svg class="tile-chart" viewBox="0 0 100 50" preserveAspectRatio="none">
            <g transform="translate(50,25)">
              <circle r="18" fill="none" stroke="var(--kg-ink)" stroke-width="9" opacity="0"/>
              <path d="M 0 -18 A 18 18 0 1 1 -12 -13.4 Z" fill="var(--kg-blueprint)"/>
              <path d="M -12 -13.4 A 18 18 0 0 1 0 -18 Z" fill="var(--kg-amber)"/>
              <path d="M 0 -18 A 18 18 0 0 1 -12 -13.4" fill="none"/>
              <circle r="9" fill="var(--kg-ink-3)"/>
            </g>
          </svg>
        </div>
        <div class="tile">
          <span class="label">type="radar"</span>
          <svg class="tile-chart" viewBox="0 0 100 50" preserveAspectRatio="none">
            <polygon points="50,6 78,20 68,42 32,42 22,20" fill="none" stroke="var(--kg-line-dark)" stroke-width="1"/>
            <polygon points="50,14 68,24 60,38 40,38 32,24" fill="rgba(79,184,201,0.35)" stroke="var(--kg-blueprint)" stroke-width="2"/>
          </svg>
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="picker">
    <div class="wrap">
      <div class="section-head">
        <span class="section-eyebrow">CHOOSE YOUR FRAMEWORK</span>
        <h2 class="section-title">Three frontends, one shared engine</h2>
        <p class="section-desc">Chart lifecycle, type registration, and options handling live in the framework-agnostic core. Vue, React, and Angular each ship a single idiomatic component on top of it.</p>
      </div>
      <div class="picker-grid">
        <div class="picker-card">
          <div class="picker-icon icon-vue"><svg viewBox="0 0 24 24" fill="#42B883"><path d="M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z"/></svg></div>
          <div class="picker-title">Vue 3</div>
          <p class="picker-desc">Composition API, a single generic &lt;Chart :type&gt; component, fully typed.</p>
          <span class="picker-status">Implemented — all 15 chart kinds, all 10 plugins</span>
          <div class="picker-links"><a class="picker-link" href="/vue/">Read the docs →</a></div>
        </div>
