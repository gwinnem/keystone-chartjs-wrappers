        <ul class="fw-select-menu" role="listbox">
          {docsFrameworks.map((f) => (
            <li>
              <a class={`fw-select-option ${isCurrent(f.docsHref) ? 'is-current' : ''}`} href={f.docsHref} role="option">
                {f.iconPath ? (
                  <svg viewBox="0 0 24 24" fill={f.color}><path d={f.iconPath}/></svg>
