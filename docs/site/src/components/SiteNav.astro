      <div class="fw-select">
        <button aria-expanded="false" aria-haspopup="listbox" class="fw-select-trigger nav-link" type="button">
          <svg class="fw-select-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/></svg>
