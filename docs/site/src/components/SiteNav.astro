            <li>
              <a class={`fw-select-option ${isCurrent(f.docsHref) ? 'is-current' : ''}`} href={f.examplesHref} role="option">
                <svg viewBox="0 0 24 24" fill={f.color}><path d={f.iconPath}/></svg>
                <span>{f.label}</span>
