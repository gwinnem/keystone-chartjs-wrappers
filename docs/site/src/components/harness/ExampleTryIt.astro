---
// Live-example "Try it" shell — Preview/Source tabs around a slotted,
// hydrated Vue island, plus copy-to-clipboard for the source. Adapted
// directly from keystone-dashboard-layout/astro-docs's own real
// ExampleTryIt.astro (read from that project's source, not guessed) —
// its own markup/behavior is entirely framework/library-agnostic (it
// just renders whatever's slotted in). Styled with only the dark-toned
// --kg-* tokens (ink/ink-2/ink-3, text-hi-dark/text-lo-dark,
// line-dark), matching every other Starlight-integrated component in
// this project (DocsHeader.astro, Sidebar.astro's own badge) — these
// tokens are fixed brand colors, not a light/dark theme-adaptive pair,
// and Starlight's own doc pages stay dark by default; the light-toned
// --kg-paper-*/--kg-text-*-light tokens exist only for the plain
// landing page's own light/dark toggle, not used here.
//
// Source syntax highlighting uses Astro's own built-in <Code> component
// (astro:components) — a real, first-party Shiki wrapper, not a
// hand-rolled highlighter integration.
import { Code } from 'astro:components';

interface Props {
  /** The filename shown in the toolbar, e.g. "bar-chart.vue". */
  filename: string;
  /** Raw source, from a `?raw` import in the consuming .mdx page. */
  code: string;
  /** Shiki language for the Source panel's syntax highlighting. */
  lang?: string;
  /** Set `false` when no component is slotted in (a real, working
   * example whose live embedding doesn't yet work on this docs site —
   * see e.g. sankey.mdx/zoom-plugin.mdx's own header comments for why).
   * Defaults to the Source tab active instead of Preview, and swaps the
   * footer's own "Live, hydrated component" claim for an accurate one,
   * rather than silently showing an empty Preview panel under a claim
   * that doesn't hold for it. */
  live?: boolean;
}

const { filename, code, lang = `vue`, live = true } = Astro.props as Props;
---

<div class="try-it not-content">
  <div class="try-it__card">
    <div class="try-it__toolbar">
      <span class="try-it__filename">{filename}</span>
      <div class="try-it__tabs" role="tablist">
        <button aria-selected={live ? 'true' : 'false'} class:list={['try-it__tab', { 'is-active': live }]} data-panel="preview" role="tab" type="button">Preview</button>
        <button aria-selected={live ? 'false' : 'true'} class:list={['try-it__tab', { 'is-active': !live }]} data-panel="source" role="tab" type="button">Source</button>
      </div>
    </div>

    <div class="try-it__panel" data-panel="preview" hidden={!live}>
      <div class="try-it__stage">
        <slot />
      </div>
    </div>

    <div class="try-it__panel try-it__panel--source" data-panel="source" hidden={live}>
      <button aria-label="Copy code to clipboard" class="try-it__copy" type="button">
        <svg class="try-it__copy-icon" fill="none" viewBox="0 0 16 16">
          <rect height="9" rx="1.5" stroke="currentColor" width="9" x="5.5" y="5.5" />
          <path d="M3.5 10.5h-1a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v1" stroke="currentColor" />
        </svg>
        <span class="try-it__tooltip">Copy code</span>
      </button>
      <Code code={code} lang={lang} theme="github-dark" wrap />
      <div class="try-it__toast" role="status">
        <svg class="try-it__toast-icon" fill="none" viewBox="0 0 16 16">
          <path d="M3 8.5l3.2 3.2L13 4.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
        </svg>
        <span class="try-it__toast-text">Copied to clipboard</span>
      </div>
    </div>

    <div class="try-it__footer">
      <svg class="try-it__footer-icon" fill="none" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="6.5" stroke="currentColor" />
        <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{live ? 'Live, hydrated component' : 'Source only — not yet live on this docs site'}</span>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.try-it__tabs').forEach((tabs) => {
    const card = tabs.closest<HTMLElement>('.try-it__card');
    if (!card) return;
    tabs.querySelectorAll<HTMLButtonElement>('.try-it__tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.panel;
        tabs.querySelectorAll<HTMLButtonElement>('.try-it__tab').forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        card.querySelectorAll<HTMLElement>('.try-it__panel').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== target;
        });
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.try-it__copy').forEach((button) => {
    const pre = button.nextElementSibling;
    if (!pre || pre.tagName !== 'PRE') return;
    const toast = button.closest<HTMLElement>('.try-it')?.querySelector<HTMLElement>('.try-it__toast');
    let hideTimeout: ReturnType<typeof setTimeout> | undefined;
    const showToast = (message: string, isError: boolean): void => {
      if (!toast) return;
      const text = toast.querySelector('.try-it__toast-text');
      if (text) text.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.classList.add('is-visible');
      clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => {
        toast.classList.remove('is-visible');
      }, 2200);
    };
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.classList.add('is-copied');
        showToast('Copied to clipboard', false);
      } catch {
        showToast('Copy failed — try selecting the code manually', true);
      }
      setTimeout(() => {
        button.classList.remove('is-copied');
      }, 1200);
    });
  });
</script>

<style>
  .try-it {
    margin: 24px 0;
  }

  .try-it__card {
    background: var(--kg-ink-2);
    border: 1px solid var(--kg-line-dark);
    border-radius: 12px;
    overflow: hidden;
  }

  .try-it__toolbar {
    align-items: center;
    background: var(--kg-ink-3);
    border-bottom: 1px solid var(--kg-line-dark);
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
  }

  .try-it__filename {
    color: var(--kg-blueprint);
    font-family: var(--kg-font-mono);
    font-size: 13px;
  }

  .try-it__tabs {
    display: flex;
    gap: 4px;
  }

  .try-it__tab {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--kg-text-lo-dark);
    cursor: pointer;
    font-family: var(--kg-font-body);
    font-size: 13px;
    font-weight: 500;
    padding: 5px 12px;
  }

  .try-it__tab.is-active {
    background: var(--kg-ink-2);
    color: var(--kg-text-hi-dark);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .try-it__tab:not(.is-active):hover {
    color: var(--kg-text-hi-dark);
  }

  .try-it__panel[hidden] {
    display: none;
  }

  .try-it__stage {
    padding: 20px;
  }

  .try-it__panel--source {
    position: relative;
  }

  .try-it__panel--source :global(pre) {
    margin: 0;
    max-height: 480px;
    overflow: auto;
    padding: 20px;
  }

  .try-it__copy {
    align-items: center;
    background: var(--kg-ink-2);
    border: 1px solid var(--kg-line-dark);
    border-radius: 6px;
    color: var(--kg-text-hi-dark);
    cursor: pointer;
    display: flex;
    height: 30px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 17px;
    top: 12px;
    transition: background-color 0.15s ease, color 0.15s ease;
    width: 30px;
    z-index: 1;
  }

  .try-it__copy-icon {
    height: 15px;
    pointer-events: none;
    width: 15px;
  }

  .try-it__copy:hover {
    background: var(--kg-blueprint-deep);
    color: white;
  }

  .try-it__copy.is-copied {
    background: var(--kg-blueprint-deep);
    border-color: var(--kg-blueprint-deep);
    color: white;
  }

  .try-it__tooltip {
    background: var(--kg-ink);
    border-radius: 4px;
    color: var(--kg-text-hi-dark);
    font-family: var(--kg-font-body);
    font-size: 11px;
    font-weight: 500;
    opacity: 0;
    padding: 4px 8px;
    pointer-events: none;
    position: absolute;
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .try-it__copy:hover .try-it__tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .try-it__toast {
    background: var(--kg-ink);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(20, 23, 26, 0.25);
    color: var(--kg-text-hi-dark);
    display: flex;
    align-items: center;
    font-family: var(--kg-font-body);
    font-size: 13px;
    gap: 8px;
    left: 50%;
    opacity: 0;
    padding: 10px 16px;
    pointer-events: none;
    position: absolute;
    top: 12px;
    transform: translate(-50%, -8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 100;
  }

  .try-it__toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .try-it__toast-icon {
    color: var(--kg-blueprint);
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .try-it__toast.is-error .try-it__toast-icon {
    color: var(--kg-amber);
  }

  .try-it__footer {
    align-items: center;
    background: var(--kg-ink-2);
    border-top: 1px solid var(--kg-line-dark);
    color: var(--kg-text-lo-dark);
    display: flex;
    font-size: 13px;
    gap: 8px;
    padding: 12px 16px;
  }

  .try-it__footer-icon {
    flex-shrink: 0;
    height: 14px;
    width: 14px;
  }
</style>
